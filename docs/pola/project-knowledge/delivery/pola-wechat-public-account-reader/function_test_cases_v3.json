          "scenario": "私人模式输入仍经过 URL 和 secret 校验",
          "assertions": [
            "私网、URL credentials 和 inline Token 被拒绝",
            "Cookie header 被拒绝",
            "鉴权请求不能跨 origin",
            "错误不泄漏环境变量值"
          ],
          "expected": "私人模式只放宽来源许可策略",
          "command": "python3 -B pola-wechat-public-account-reader/scripts/run_harness.py"
        }
      ],
      "integration_cases": [
        {
          "id": "V3-IT-F5-001",
          "target": "tests/test_http_security.py",
          "scenario": "传输、容量和 deadline 回归",
          "assertions": [
            "DNS pin 和 SSRF 门禁通过",
            "响应、gzip、分页、候选和正文有上限",
            "slow-trickle 被绝对 deadline 中止",
            "运行锁和 SQLite 事务保持"
          ],
          "expected": "扩大来源集合不会扩大到本机网络或无界任务",
          "command": "python3 -B pola-wechat-public-account-reader/scripts/run_harness.py"
        }
      ],
