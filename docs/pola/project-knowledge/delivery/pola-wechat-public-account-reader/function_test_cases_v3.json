          "assertions": [
            "三个命令接受 --private-use",
            "validate 输出策略和三个审计清单",
            "cron 生成命令只含一个 --private-use",
            "cron 仍只打印不安装"
          ],
          "expected": "一次性覆盖与定时运行使用相同来源策略",
          "command": "python3 -B pola-wechat-public-account-reader/scripts/run_harness.py"
        },
        {
          "id": "V3-UT-F4-002",
          "target": "scripts/pola_wechat_reader/reporting.py",
          "scenario": "JSON/Markdown 显示私人策略",
          "assertions": [
            "selection.source_permission_policy=private_opt_in",
            "permission_overrides 不包含 secret",
            "Markdown 显示策略及三个审计清单的来源标识"
          ],
          "expected": "私人模式不静默运行且报告可安全渲染",
          "command": "python3 -B pola-wechat-public-account-reader/scripts/run_harness.py"
        }
