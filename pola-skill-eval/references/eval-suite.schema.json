{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pola-skill-eval/eval-suite.schema.json",
  "title": "Pola Skill Eval Suite",
  "type": "object",
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "mode": {"enum": ["quick", "standard", "release"]},
    "defaults": {
      "type": "object",
      "properties": {
        "trials": {"type": "integer", "minimum": 1, "maximum": 20},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600},
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "candidate_success_min": {"type": "number", "minimum": 0, "maximum": 1},
        "uplift_min": {"type": "number", "minimum": -1, "maximum": 1},
        "trigger_f1_min": {"type": "number", "minimum": 0, "maximum": 1},
        "max_p95_duration_ms": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "prompt", "graders"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "category": {
            "enum": [
              "trigger_positive",
              "trigger_negative",
              "task_success",
              "robustness",
              "security",
              "performance",
              "coexistence"
            ]
          },
          "split": {"enum": ["authoring", "holdout", "regression"]},
          "prompt": {"type": "string", "minLength": 1},
          "should_trigger": {"type": "boolean"},
          "trials": {"type": "integer", "minimum": 1, "maximum": 20},
          "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600},
          "max_output_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 10485760
          },
          "graders": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": [
                    "exit_code",
                    "stdout_contains",
                    "stdout_not_contains",
                    "response_contains",
                    "response_not_contains",
                    "response_regex",
                    "file_exists",
                    "json_path_equals",
                    "max_duration_ms",
                    "max_output_bytes",
                    "skill_invoked"
                  ]
                },
                "severity": {"enum": ["critical", "high", "medium", "info"]}
              }
            }
          }
        }
      }
    }
  }
}
